{
  "name": "Post-Pooja Review Request (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "days", "hoursInterval": 24 }]
        }
      },
      "id": "schedule-daily",
      "name": "Daily 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID"
        },
        "sheetName": "Bookings",
        "filters": {
          "combineFilters": "AND",
          "conditions": [
            {
              "leftValue": "Status",
              "rightValue": "Completed"
            },
            {
              "leftValue": "Reviewed",
              "rightValue": "No"
            }
          ]
        }
      },
      "id": "sheets-read",
      "name": "Read Completed Bookings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [260, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-days",
              "leftValue": "={{ $now.diff($json.PoojaDate, 'day') }}",
              "rightValue": 1,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-due",
      "name": "Is 1+ day after pooja?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "operation": "send",
        "resource": "message",
        "phoneNumberField": "to",
        "message": {
          "content": "={{ 'Namaste ' + ($json.Name ?? '') + '! 🙏 Hope your ' + ($json.PoojaType ?? 'puja') + ' at ' + ($json.Temple ?? 'Ujjain') + ' brought peace. We would be grateful if you shared your experience — it helps other devotees. Google review link: ' + ($json.ReviewLink ?? '') }}"
        }
      },
      "id": "wa-review",
      "name": "WhatsApp Review Request",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [780, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID"
        },
        "sheetName": "Bookings",
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "Reviewed": "Requested" }
        },
        "filters": {
          "combineFilters": "AND",
          "conditions": [
            { "leftValue": "Phone", "rightValue": "={{ $json.Phone }}" }
          ]
        }
      },
      "id": "sheets-mark",
      "name": "Mark Reviewed=Requested",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [780, 300]
    }
  ],
  "connections": {
    "Daily 9 AM": {
      "main": [[{ "node": "Read Completed Bookings", "type": "main", "index": 0 }]]
    },
    "Read Completed Bookings": {
      "main": [[{ "node": "Is 1+ day after pooja?", "type": "main", "index": 0 }]]
    },
    "Is 1+ day after pooja?": {
      "main": [
        [{ "node": "WhatsApp Review Request", "type": "main", "index": 0 }],
        []
      ]
    },
    "WhatsApp Review Request": {
      "main": [[{ "node": "Mark Reviewed=Requested", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
